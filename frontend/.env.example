# ==============================================================================
# FITLOOM Server Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env or .env.local to version control.
# Never use NEXT_PUBLIC_ for secrets.
# ==============================================================================

# Neon Serverless PostgreSQL connection string
# Developers: Connect to your OWN personal Neon branch (never develop directly on production).
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/fitloom?sslmode=require"

# Better Auth Configuration (Secret must be at least 32 characters)
BETTER_AUTH_SECRET="replace-with-a-secure-32-character-secret-minimum"
# Better Auth base URL
# Production: Canonical app domain (e.g. https://fitloom.app or https://your-deployment.vercel.app)
# Local development: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# CORS / CSRF Origin Configuration (comma-separated if multiple origins)
# Production: Allowed domains (e.g. https://fitloom.app,https://www.fitloom.app)
# Local development: http://localhost:3000
ALLOWED_ORIGINS="http://localhost:3000"

# 3D Avatar Engine Service (FastAPI service running on port 8010)
AVATAR_SERVICE_URL="http://127.0.0.1:8010"
AVATAR_SERVICE_TOKEN=""
AVATAR_SERVICE_TIMEOUT_MS="5000"
